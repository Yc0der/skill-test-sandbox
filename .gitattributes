* text=auto eol=lf

# The husky hooks are shell scripts. If git rewrites them to CRLF on a Windows
# checkout, /bin/sh fails on the trailing \r and the hook either errors or is
# silently skipped — so force LF regardless of core.autocrlf.
.husky/* text eol=lf
*.sh text eol=lf

# Collapse the lockfile in review and skip its diff — it's machine-written and huge.
pnpm-lock.yaml -diff linguist-generated

# The changelog is generated too, but its diff is the thing you actually want to
# read in a PR, so only collapse it by default — don't suppress the diff.
CHANGELOG.md linguist-generated
